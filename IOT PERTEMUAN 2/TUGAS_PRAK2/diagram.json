{
  "version": 1,
  "author": "Nama Anda",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": -150.4,
      "left": -248.8,
      "attrs": { "lux": "500" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -150,
      "left": 200,
      "attrs": { "temperature": "25", "humidity": "50" }
    },
    { "type": "wokwi-relay-module", "id": "relay", "top": 150, "left": -250, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 150, "left": 200, "attrs": { "color": "red" } },
    {
      "type": "wokwi-resistor",
      "id": "r_led",
      "top": 200,
      "left": 200,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:3V3", "ldr:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "ldr:GND", "black", [ "v0" ] ],
    [ "esp:D34", "ldr:AO", "green", [ "v0" ] ],
    [ "esp:3V3", "dht:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "dht:GND", "black", [ "v0" ] ],
    [ "esp:D27", "dht:SDA", "green", [ "v0" ] ],
    [ "esp:VIN", "relay:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "relay:GND", "black", [ "v0" ] ],
    [ "esp:D26", "relay:IN", "green", [ "v0" ] ],
    [ "esp:D2", "r_led:1", "green", [ "v0" ] ],
    [ "r_led:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "serialMonitor": { "display": "always" },
  "dependencies": {}
